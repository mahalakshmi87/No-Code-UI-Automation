"return {\n  \"meta\":{\n    \"name\":\"dupcheck$dc3DuplicateResult\",\n    \"extends\":\"markup://aura:component\"\n  },\n  \"controller\":{\n    \"init\":function(component, event, helper) {\n        helper.setLicenseInformation(component);\n        \n        component.set(\'v.selectedTab\', component.get(\'v.searchResult.firstObject\'));\n\n        window.addEventListener(\n            \'message\',\n            function (event) {\n                try {\n                    helper.handleEvent(component, event, component.get(\'v.baseUrl\'));\n                } catch (e) {\n                    console.error(e);\n                }\n            },\n            false\n        );\n\n        let userId = $A.get(\'$SObjectType.CurrentUser.Id\');\n        component.set(\'v.userId\', userId);\n\n        var action = component.get(\'c.getUIThemeDescription\');\n        action.setCallback(this, function (a) {\n            console.log(\'Theme: \' + a.getReturnValue());\n            if (a.getReturnValue() == \'Theme3\' || a.getReturnValue() == \'Theme2\') {\n                component.set(\'v.isLEX\', false);\n            }\n        });\n        $A.enqueueAction(action);\n    },\n    \"onRender\":function(component, event, helper) {\n        if (component.get(\'v.tableWidth\') != \'100%\') {\n            var duplicateTableDiv = component.find(\'duplicateTable\');\n            if (duplicateTableDiv) {\n                if ($A.util.isArray(duplicateTableDiv)) {\n                    duplicateTableDiv.forEach((innerDiv) =\u003E {\n                        $A.util.addClass(innerDiv, \'scrollable_x\');\n                    });\n                } else {\n                    $A.util.addClass(duplicateTableDiv, \'scrollable_x\');\n                }\n            }\n\n            var duplicateTableInnerDiv = component.find(\'duplicateTableInner\');\n            if (duplicateTableInnerDiv) {\n                if (duplicateTableInnerDiv instanceof Array) {\n                    duplicateTableInnerDiv.forEach((innerDiv) =\u003E {\n                        innerDiv.getElement().style.setProperty(\'width\', component.get(\'v.tableWidth\'));\n                    });\n                } else {\n                    duplicateTableInnerDiv.getElement().style.setProperty(\'width\', component.get(\'v.tableWidth\'));\n                }\n            }\n        }\n    },\n    \"handleRowAction\":function(cmp, event, helper) {\n        var action = event.getParam(\'action\');\n        var row = event.getParam(\'row\');\n        var recordId = row.id;\n\n        switch (action.name) {\n            case \'open_record\':\n                helper.navigateToRecord(cmp, recordId, true);\n                break;\n            case \'convert_record\':\n                console.log(\'convert \' + recordId);\n                helper.openConvert(cmp, recordId);\n                break;\n            case \'merge_record\':\n                helper.gotoMerge(cmp, [cmp.get(\'v.searchResult.objectId\'), recordId], \'/\' + cmp.get(\'v.searchResult.objectId\'), \'Row\');\n                break;\n        }\n    },\n    \"handleCloseModal\":function(cmp, event) {\n        console.log(\'close modal handler\');\n        cmp.set(\'v.openConvertModal\', false);\n\n        if (event.getParam(\'converted\')) {\n            console.log(\'Converted\');\n\n            var navEvt = $A.get(\'e.force:navigateToSObject\');\n            navEvt.setParams({\n                recordId: event.getParam(\'accountId\'),\n                slideDevName: \'detail\'\n            });\n            navEvt.fire();\n        }\n    },\n    \"handleRowSelection\":function(cmp, event, helper) {\n        var sourceRecord = cmp.get(\'v.searchResult.objectId\');\n        var sourcePrefix = cmp.get(\'v.searchResult.firstObject\');\n        var prefix = event.getSource().get(\'v.class\');\n        var count = event.getParam(\'selectedRows\').length;\n        var minimal = 1;\n        var minimalMerge = 2;\n\n        if (sourceRecord && prefix == sourcePrefix) {\n            minimalMerge = 1;\n        }\n\n        var buttonVisible = cmp.get(\'v.buttonVisible\');\n        if (count \u003E= minimal) {\n            if (buttonVisible.indexOf(prefix) == -1) {\n                buttonVisible.push(prefix);\n            }\n        } else {\n            var index = buttonVisible.indexOf(prefix);\n            if (index \u003E -1) buttonVisible.splice(index, 1);\n        }\n        cmp.set(\'v.buttonVisible\', buttonVisible);\n\n        var mergeButtonVisible = cmp.get(\'v.mergeButtonVisible\');\n        if (count \u003E= minimalMerge) {\n            if (mergeButtonVisible.indexOf(prefix) == -1) {\n                mergeButtonVisible.push(prefix);\n            }\n        } else {\n            var index = mergeButtonVisible.indexOf(prefix);\n            if (index \u003E -1) mergeButtonVisible.splice(index, 1);\n        }\n        cmp.set(\'v.mergeButtonVisible\', mergeButtonVisible);\n    },\n    \"handleClickMerge\":function(cmp, event, helper) {\n        var prefix = event.getSource().get(\'v.name\');\n        var selectedRecords = helper.getSelectedRecords(cmp, prefix);\n\n        var sourceRecord = cmp.get(\'v.searchResult.objectId\');\n        var sourcePrefix = cmp.get(\'v.searchResult.firstObject\');\n\n        if (sourceRecord && prefix == sourcePrefix) {\n            selectedRecords.push(sourceRecord);\n        }\n\n        helper.gotoMerge(cmp, selectedRecords, \'/\' + sourceRecord, \'List\');\n    },\n    \"handleClickDiscard\":function(cmp, event, helper) {\n        var prefix = event.getSource().get(\'v.name\');\n        var relation = event.getParam(\'value\');\n        var selectedRecords = helper.getSelectedRecords(cmp, prefix);\n        var sourceRecord = cmp.get(\'v.searchResult.objectId\');\n\n        helper.createDisardRelation(cmp, sourceRecord, selectedRecords, relation, function (res) {\n            cmp.getEvent(\'refreshDuplicateResult\').fire();\n        });\n    }\n  },\n  \"helper\":{\n    \"setLicenseInformation\":function(cmp) {\n        var action = cmp.get(\'c.getLicense\');\n        action.setCallback(this, function (response) {\n            if (response.getState() === \'SUCCESS\') {\n                cmp.set(\'v.license\', response.getReturnValue());\n            } else {\n                console.log(response.getState());\n                console.log(response.getError());\n            }\n        });\n        $A.enqueueAction(action);\n    },\n    \"setBaseUrl\":function(cmp) {\n        var action = cmp.get(\'c.getBaseUrl\');\n        action.setCallback(this, function (response) {\n            if (response.getState() === \'SUCCESS\') {\n                cmp.set(\'v.baseUrl\', response.getReturnValue());\n                console.log(\'baseUrl : \' + response.getReturnValue());\n            } else {\n                console.log(response.getState());\n                console.log(response.getError());\n            }\n        });\n        $A.enqueueAction(action);\n    },\n    \"createDisardRelation\":function(cmp, sourceId, discardIds, relation, successCallback) {\n        this.telemetryRecordEvent(cmp, \'Live - Discard \' + relation + \' Button clicked\', {\n            object_prefix: sourceId.slice(0, 3),\n            number_of_records: discardIds.length,\n            discard_reason: relation\n        });\n        this.telemetryPersist(cmp);\n\n        var action = cmp.get(\'c.createDiscardRecords\');\n        action.setParams({\n            sourceRecord: sourceId,\n            dicardedIds: discardIds,\n            relation: relation\n        });\n        action.setCallback(this, function (response) {\n            var state = response.getState();\n            if (state === \'SUCCESS\') {\n                successCallback(response.getReturnValue());\n            }\n        });\n        $A.enqueueAction(action);\n    },\n    \"getSelectedRecords\":function(cmp, prefix) {\n        var dtList = cmp.find(\'dtdup\');\n        var dtdup;\n        if (!dtList) {\n            return;\n        } else if ($A.util.isArray(dtList)) {\n            for (var i = 0, len = dtList.length; i \u003C len; i++) {\n                if (dtList[i].get(\'v.class\') == prefix) {\n                    dtdup = dtList[i];\n                }\n            }\n        } else {\n            dtdup = dtList;\n        }\n\n        var selected = dtdup.getSelectedRows();\n        if (selected.length == 0) {\n            return [];\n        }\n\n        var returnArray = [];\n        for (var i = 0, len = selected.length; i \u003C len; i++) {\n            returnArray.push(selected[i].id);\n        }\n        return returnArray;\n    },\n    \"sendClassicForward\":function(forwardTo, recordId, uri, openInNewTab) {\n        var forwardEvent = new CustomEvent(\'plauti-dc-live-forward\', {\n            bubbles: true,\n            cancelable: false,\n            detail: {\n                forwardTo: forwardTo,\n                recordId: recordId,\n                uri: uri,\n                openInNewTab: openInNewTab\n            }\n        });\n        document.dispatchEvent(forwardEvent);\n    },\n    \"navigateToRecord\":function(cmp, recordId, newTab) {\n        var context = cmp.get(\'v.userContext\');\n        var openInNewTab = cmp.get(\'v.openInNewTab\');\n\n        let target = \'lightning_record\';\n        if (context && typeof sforce != \'undefined\' && sforce && !!sforce.one) {\n            target = \'sforce_one_record\';\n        } else if (context) {\n            target = \'classic_record\';\n        } else if (openInNewTab && newTab) {\n            target = \'new_window\';\n        }\n\n        this.telemetryRecordEvent(cmp, \'Live - Record Open clicked\', {\n            object_prefix: recordId.slice(0, 3),\n            target: target\n        });\n        this.telemetryPersist(cmp);\n\n        if (context) {\n            if (typeof sforce != \'undefined\' && sforce && !!sforce.one) {\n                sforce.one.navigateToSObject(recordId);\n            } else {\n                this.sendClassicForward(\'open-record\', recordId, undefined, openInNewTab);\n            }\n        } else {\n            if (openInNewTab && newTab) {\n                window.open(\'/\' + recordId, \'_blank\');\n            } else {\n                var sObjectEvent = $A.get(\'e.force:navigateToSObject\');\n                sObjectEvent.setParams({\n                    recordId: recordId,\n                    slideDevName: \'detail\'\n                });\n                sObjectEvent.fire();\n            }\n        }\n    },\n    \"navigateToUrl\":function(cmp, url, uri) {\n        var context = cmp.get(\'v.userContext\');\n        console.log(\'context : \' + context);\n        console.log(\'url : \' + url);\n        console.log(\'uri : \' + uri);\n\n        var tempUrl;\n        if (uri.indexOf(\'?\') \u003E -1) {\n            tempUrl = url + uri;\n        } else {\n            tempUrl = url + \'?\' + uri;\n        }\n        console.log(tempUrl);\n\n        if (context) {\n            if (typeof sforce != \'undefined\' && sforce && !!sforce.one) {\n                if (url == \'/apex/dupcheck__dc3Convert\') {\n                    tempUrl = cmp.get(\'v.classicConvert\') + \'&\' + uri;\n                }\n                sforce.one.navigateToURL(tempUrl);\n            } else {\n                this.sendClassicForward(url, undefined, uri, false);\n            }\n        } else {\n            var urlEvent = $A.get(\'e.force:navigateToURL\');\n            urlEvent.setParams({\n                url: tempUrl\n            });\n            urlEvent.fire();\n        }\n    },\n    \"openMerge\":function(cmp, url, uri) {\n        let dc3MergeModal = cmp.find(\'dc3MergeModal\');\n        let finalurl = url + uri + \'&isdtp=vw&modal=true\';\n        dc3MergeModal.openMerge(finalurl);\n    },\n    \"closeMerge\":function(cmp) {\n        console.log(\'close merge!\');\n        let dc3MergeModal = cmp.find(\'dc3MergeModal\');\n        if (dc3MergeModal != null) {\n            dc3MergeModal.hide();\n        }\n    },\n    \"gotoMerge\":function(cmp, idList, returnUrl, source) {\n        var payload = JSON.stringify({name: \'OPEN_MODAL\', idList: idList, type: \'idList\', meta: \'REDIRECT\', context: \'Live\'});\n        let isLEX = cmp.get(\'v.isLEX\');\n\n        let target = \'lightning_redirect\';\n        if (cmp.get(\'v.openInModal\')) {\n            target = \'modal\';\n        } else if (!isLEX) {\n            target = \'classic_redirect\';\n        }\n\n        this.telemetryRecordEvent(cmp, \'Live - Merge \' + source + \' Button clicked\', {\n            object_prefix: idList[0].slice(0, 3),\n            number_of_records: idList.length,\n            target: target\n        });\n        this.telemetryPersist(cmp);\n\n        if (cmp.get(\'v.openInModal\')) {\n            window.dispatchEvent(new CustomEvent(\'dupcheck__dc3Merge\', {detail: payload}));\n        } else if (!isLEX) {\n            this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Merge\', \'ids=\' + idList.join());\n        } else {\n            this.navigateToUrl(cmp, \'/lightning/cmp/dupcheck__dc3MergePage\', \'c__mergeData=\' + encodeURI(payload));\n        }\n    },\n    \"isJson\":function(str) {\n        try {\n            var o = JSON.parse(str);\n            if (o && typeof o === \'object\') {\n                return true;\n            }\n        } catch (e) {\n            return false;\n        }\n        return false;\n    },\n    \"isBaseUrl\":function(baseUrl, origin) {\n        if (!baseUrl) {\n            return false;\n        }\n        return baseUrl.startsWith(origin);\n    },\n    \"handleEvent\":function(cmp, eventData, baseUrl) {\n        try {\n            if (!eventData.origin.endsWith(\'dupcheck.visualforce.com\') && !/dupcheck.+visual\\.force\\.com/gm.test(eventData.origin) && !this.isBaseUrl(baseUrl, eventData.origin) && !eventData.origin.endsWith(\'lightning.force.com\')) {\n                console.log(\"URL doesn\'t match : \" + eventData.origin + \' -- \' + baseUrl);\n                return;\n            }\n\n            if (!this.isJson(eventData.data)) {\n                return;\n            }\n\n            var e = JSON.parse(eventData.data);\n            if (e.name === \'dupcheck__dc3Merge\') {\n                if (e.payload.status === \'MERGE_OK\') {\n                    helper.closeMerge(component);\n                    this.sendToast(\'success\', \'Success!\', \'The records have been merged.\');\n                    $A.get(\'e.force:refreshView\').fire();\n                } else if (e.payload.status === \'MERGE_OK_SET\') {\n                    helper.closeMerge(component);\n                    this.sendToast(\'success\', \'Success!\', \'The records have set for merge.\');\n                    $A.get(\'e.force:refreshView\').fire();\n                }\n            } else if (e.name === \'dupcheck__dc3Convert\') {\n                if (e.payload.status === \'CONVERT_OK\') {\n                    if (!e.payload.recordId || e.payload.recordId == cmp.get(\'v.sourceRecord\')) {\n                        $A.get(\'e.force:refreshView\').fire();\n                    } else {\n                        this.navigateToRecord(cmp, e.payload.recordId, false);\n                    }\n                    this.sendToast(\'success\', \'Success!\', \'The record has been converted.\');\n                }\n            }\n        } catch (e) {\n            console.error(e);\n        }\n    },\n    \"sendToast\":function(type, title, message) {\n        var toastEvent = $A.get(\'e.force:showToast\');\n        toastEvent.setParams({\n            title: title,\n            message: message,\n            type: type\n        });\n        toastEvent.fire();\n    },\n    \"openConvert\":function(cmp, recordId) {\n        let sourceRecord = cmp.get(\'v.sourceRecord\');\n        let isLEX = cmp.get(\'v.isLEX\') && cmp.get(\'v.openInModal\');\n        console.log(\'Source record id: \' + sourceRecord);\n        console.log(\'Selected record id: \' + recordId);\n        console.log(\'LEX: \' + isLEX);\n\n        cmp.set(\'v.selectedContactId\', null);\n        cmp.set(\'v.selectedAccountId\', null);\n        cmp.set(\'v.leadId\', null);\n\n        let target = \'classic_redirect\';\n        if (isLEX) {\n            target = \'modal\';\n        }\n\n        this.telemetryRecordEvent(cmp, \'Live - Convert Button clicked\', {\n            object_prefix: sourceRecord.slice(0, 3),\n            convert_to_prefix: recordId.slice(0, 3),\n            target: target\n        });\n        this.telemetryPersist(cmp);\n\n        \n        if (sourceRecord.startsWith(\'003\')) {\n            cmp.set(\'v.selectedContactId\', sourceRecord);\n\n            if (recordId.startsWith(\'001\')) {\n                cmp.set(\'v.selectedAccountId\', recordId);\n\n                if (isLEX) {\n                    cmp.set(\'v.openConvertModal\', true);\n                } else {\n                    this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'contactId=\' + sourceRecord + \'&accountId=\' + recordId);\n                    \n                }\n            } else if (recordId.startsWith(\'00Q\')) {\n                cmp.set(\'v.leadId\', recordId);\n                var action = cmp.get(\'c.getContactAccountInfo\');\n                action.setParams({\n                    contactId: sourceRecord\n                });\n                action.setCallback(this, function (response) {\n                    if (cmp.isValid()) {\n                        let state = response.getState();\n                        if (state === \'SUCCESS\') {\n                            let searchResult = response.getReturnValue();\n                            cmp.set(\'v.selectedAccountId\', searchResult.id);\n\n                            if (isLEX) {\n                                cmp.set(\'v.openConvertModal\', true);\n                            } else {\n                                this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'leadId=\' + recordId + \'&accountId=\' + searchResult.id);\n                                \n                            }\n                        } else if (state === \'ERROR\') {\n                            cmp.set(\'v.selectedAccountId\', null);\n                            if (isLEX) {\n                                cmp.set(\'v.openConvertModal\', true);\n                            } else {\n                                this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'leadId=\' + recordId);\n                                \n                            }\n                        }\n                    }\n                });\n                $A.enqueueAction(action);\n            }\n        }\n\n        \n        if (sourceRecord.startsWith(\'00Q\')) {\n            cmp.set(\'v.leadId\', sourceRecord);\n\n            if (recordId.startsWith(\'001\')) {\n                cmp.set(\'v.selectedAccountId\', recordId);\n\n                if (isLEX) {\n                    cmp.set(\'v.openConvertModal\', true);\n                } else {\n                    this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'leadId=\' + sourceRecord + \'&accountId=\' + recordId);\n                    \n                }\n            } else if (recordId.startsWith(\'003\')) {\n                cmp.set(\'v.selectedContactId\', recordId);\n\n                var action = cmp.get(\'c.getContactAccountInfo\');\n                action.setParams({\n                    contactId: recordId\n                });\n                action.setCallback(this, function (response) {\n                    if (cmp.isValid()) {\n                        let state = response.getState();\n                        if (state === \'SUCCESS\') {\n                            let searchResult = response.getReturnValue();\n                            cmp.set(\'v.selectedAccountId\', searchResult.id);\n\n                            if (isLEX) {\n                                cmp.set(\'v.openConvertModal\', true);\n                            } else {\n                                this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'leadId=\' + sourceRecord + \'&contactId=\' + recordId + \'&accountId=\' + searchResult.id);\n                                \n                            }\n                        } else if (state === \'ERROR\') {\n                            cmp.set(\'v.selectedAccountId\', null);\n\n                            if (isLEX) {\n                                cmp.set(\'v.openConvertModal\', true);\n                            } else {\n                                this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'leadId=\' + sourceRecord + \'&contactId=\' + recordId);\n                                \n                            }\n                        }\n                    }\n                });\n                $A.enqueueAction(action);\n            }\n        }\n\n        \n        if (sourceRecord.startsWith(\'001\')) {\n            cmp.set(\'v.selectedAccountId\', sourceRecord);\n\n            if (recordId.startsWith(\'003\')) {\n                cmp.set(\'v.selectedContactId\', recordId);\n\n                if (isLEX) {\n                    cmp.set(\'v.openConvertModal\', true);\n                } else {\n                    this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'contactId=\' + recordId + \'&accountId=\' + sourceRecord);\n                    \n                }\n            } else if (recordId.startsWith(\'00Q\')) {\n                cmp.set(\'v.leadId\', recordId);\n\n                if (isLEX) {\n                    cmp.set(\'v.openConvertModal\', true);\n                } else {\n                    this.navigateToUrl(cmp, \'/apex/dupcheck__dc3Convert\', \'leadId=\' + recordId + \'&accountId=\' + sourceRecord);\n                    \n                }\n            }\n        }\n    },\n    \"telemetryRecordEvent\":function(cmp, eventName, properties) {\n        var telemetryClient = cmp.find(\'telemetryClient\');\n        telemetryClient.recordEvt(eventName, properties);\n    },\n    \"telemetryPersist\":function(cmp) {\n        var telemetryClient = cmp.find(\'telemetryClient\');\n        telemetryClient.persist();\n    }\n  }\n};\n", def, "evaluateInSandbox");
});
