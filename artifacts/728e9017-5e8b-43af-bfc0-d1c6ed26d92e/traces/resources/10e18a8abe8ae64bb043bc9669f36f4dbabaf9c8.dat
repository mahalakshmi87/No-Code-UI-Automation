$A.componentService.addComponent("markup://cloudmaven_bcr:BINSearch",function(){/*$A.componentService.addComponentClass("markup://cloudmaven_bcr:BINSearch",function() {
  var def = $A.componentService.getDef("markup://cloudmaven_bcr:BINSearch");  return $A.lockerService.createForDefNext(
"return {\n  \"meta\":{\n    \"name\":\"cloudmaven_bcr$BINSearch\",\n    \"extends\":\"markup://aura:component\"\n  },\n  \"controller\":{\n    \"init\":function(component, event, helper) {\n        console.log(\'component.get(\"v.selectedProduct\")\' + component.get(\"v.recordId\"));\n        helper.getProductEntitlements(component, helper);\n        helper.getCommonSetting(component);\n        helper.checkForExistingReports(component, helper);\n        component.set(\"v.runReportConfirmMsg\", $A.get(\"$Label.cloudmaven_bcr.Report_Run_Confirmation_Box_Message\").replace(\'{{DATE}}\', \'\'));\n    },\n    \"onPageReferenceChange\":function(component, event, helper) {\n        var myPageRef = component.get(\"v.pageReference\");\n        var id = myPageRef.state.c__id;\n        component.set(\"v.recordId\", id);\n    },\n    \"handleProductChange\":function(component, event, helper) {\n        var selectedProduct = component.get(\"v.selectedProduct\");\n        var productEntitlements = component.get(\"v.productEntitlements\");\n        if(selectedProduct != \"--Select--\"){\n            component.set(\"v.productDesc\", productEntitlements[selectedProduct]);   \n        }\n        else {\n            component.set(\"v.productDesc\", \"\");    \n        }\n        \n    },\n    \"runCreditReport\":function(component, event, helper) {\n        var selectedRow = component.get(\'v.selectedRow\');\n        if( selectedRow != undefined ){\n            if( component.get(\'v.lastReportRunDate\') == undefined ) {\n                console.log(\'CALLING createCreditReport \');\n                helper.createCreditReport(component, selectedRow, true, false );\n            }\n            else {\n                component.set(\"v.showReportConfirmationBox\", true);\n            }\n        }\n    },\n    \"runReportOnConfirmation\":function(component, event, helper) {\n        var selectedRow = component.get(\'v.selectedRow\');\n        if( selectedRow != undefined ){\n            console.log(\'CALLING createCreditReport \');\n            component.set(\"v.showReportConfirmationBox\", false);\n            helper.createCreditReport(component, selectedRow, true, false );\n        }    \n    },\n    \"handleUpdateAccount\":function(component, event, helper) {\n        console.log(\"IN handleUpdateAccount\");\n        var index = event.getParam(\"index\");\n        var selectedRow = component.get(\"v.data\")[index];\n        if( selectedRow != undefined ){\n            helper.createCreditReport(component, selectedRow, false, true );\n        }\n    },\n    \"updateAccountRunCreditReport\":function(component, event, helper) {\n        var selectedRow = component.get(\'v.selectedRow\');\n        if( selectedRow != undefined ){\n            helper.createCreditReport(component, selectedRow, true, true );\n        }\n    },\n    \"moveToNextStep\":function(component, event, helper) {\n        console.log(\' inside moveToNextStep\u003E\u003E\');\n        var idx;\n        if(event.currentTarget) {\n            idx = event.currentTarget.dataset.bureauname;\n        }\n        if(event.target && idx == undefined ) {\n            idx = event.currentTarget.dataset.bureauname;\n        }\n        if(idx) {\n            helper.renderScreenForProductSelection(component, helper, idx);\n        }\n    },\n    \"handleOnCardSelect\":function(component, event, helper) {\n        var indx = event.getParam(\"index\");\n        var selectedRow = component.get(\"v.data\")[indx];\n        component.set(\"v.selectedRow\", selectedRow);\n        component.set(\"v.selectedIndex\", indx)\n    },\n    \"closeReportConfirmationBox\":function(component, event, helper) {\n        component.set(\"v.showReportConfirmationBox\", false);\n    }\n  },\n  \"helper\":{\n    \"fetchData\":function(component, bureauName) {\n        console.log(\'\u003E\u003E\u003E\u003E\' + component.get(\"v.recordId\"));\n        component.set(\"v.showSpinner\", true);\n        var action = component.get(\"c.searchBusinessOnBureau\");\n        action.setParams({\n            \"recordId\": component.get(\"v.recordId\"),\n            \"sObjectName\": component.get(\"v.sObjectName\"),\n            \"bureauName\": bureauName,\n            \"bureauSubCode\": component.get(\"v.bureauSubCode\"),\n            \"countryCode\": component.get(\"v.country3Code\")\n        });\n        action.setCallback(this, function(response) {\n            var state = response.getState();\n            if (state === \"SUCCESS\") {\n                var res = JSON.parse(response.getReturnValue());\n                this.processSearchResults( component, res );\n				\n            } else {\n                component.set(\"v.message\", response.getError());\n                console.log(\'Error \', response.getError());\n                this.handleErrors(response.getError());\n            }\n            component.set(\"v.showSpinner\", false);\n            component.set(\"v.searchOperationCompleted\", true);\n        });\n        $A.enqueueAction(action);\n    },\n    \"getCommonSetting\":function(component) {\n\n        var action = component.get(\"c.getMinScore\");\n\n        action.setCallback(this, function(response) {\n\n            var state = response.getState();\n\n            if (state === \"SUCCESS\") {\n\n                component.set(\"v.minScore\", response.getReturnValue());\n\n            } else {\n                this.handleErrors(response.getError());\n                console.log(\'Error \', response.getError());\n                component.set(\"v.showSpinner\", false);\n            }\n        });\n\n        $A.enqueueAction(action);\n\n    },\n    \"lookForBINOnRecord\":function(component, bureauName) {\n        var action = component.get(\"c.checkRecordHasBIN\");\n        action.setParams({\n            \"recordId\": component.get(\"v.recordId\"),\n            \"sObjectName\": component.get(\"v.sObjectName\"),\n            \"bureauName\": bureauName\n        });\n        action.setCallback(this, function(response) {\n            var state = response.getState();\n            if (state === \"SUCCESS\") {\n\n                var res = JSON.parse(response.getReturnValue());\n                if (!res) {\n                    this.fetchData(component, bureauName);\n                } else {\n                    component.set(\"v.binExist\", true);\n                    component.set(\"v.data\", res);\n                    component.set(\"v.isDataAvailable\", true);\n                    component.set(\"v.message\", \'\');\n                    component.set(\"v.searchOperationCompleted\", true);\n                    component.set(\"v.showSpinner\", false);\n                    \n                    if(bureauName === \'Experian\' &&  component.get(\"v.country3Code\") !== \'USA\') {\n                        component.set(\"v.isGlobalSearchOnExperian\", true);\n                    }\n                }\n                \n            } else {\n                console.log(\'Error \', response.getError());\n                component.set(\"v.showSpinner\", false);\n                this.handleErrors(response.getError());\n            }\n        });\n        $A.enqueueAction(action);\n    },\n    \"getProductEntitlements\":function(component, helper) {\n\n        \n        var action = component.get(\"c.getProductEntitlements\");\n        action.setParams({ \"recordId\": component.get(\"v.recordId\"), \"sObjectName\": component.get(\"v.sObjectName\") });\n        action.setCallback(this, function(response) {\n\n            var state = response.getState();\n\n            if (state === \"SUCCESS\") {\n\n                var responseObj = response.getReturnValue();\n                if (!responseObj.sWarningMessage) {\n                    component.set(\"v.productEntitlements\", responseObj.mapProductDescription);\n                    component.set(\"v.experianProducts\", responseObj.mapBureauProductName[\'Experian\']);\n                    component.set(\"v.paynetProducts\", responseObj.mapBureauProductName[\'Paynet\']);\n                    component.set(\"v.equifaxProducts\", responseObj.mapBureauProductName[\'Equifax\']);\n                    component.set(\"v.bureauSubCode\",responseObj.mapBureauSubCode[\'Experian\']);\n                    component.set(\"v.country3Code\",responseObj.sCountryCode);\n                    \n                            \n                    if( Object.keys(responseObj.mapBureauProductName).length == 1 ) {\n                        if( responseObj.mapBureauProductName[\'Experian\'] !== undefined && responseObj.mapBureauProductName[\'Experian\'].length \u003E 0 ) {\n                        	helper.renderScreenForProductSelection(component, this, \'Experian\');    \n                            console.log(\'Calling default bureau Experian\');\n                        }\n                        else if( responseObj.mapBureauProductName[\'Paynet\'] !== undefined && responseObj.mapBureauProductName[\'Paynet\'].length \u003E 0 ) {\n                        	helper.renderScreenForProductSelection(component, this, \'Paynet\');       \n                            console.log(\'Calling default bureau Paynet\');\n                        }\n                        else if( responseObj.mapBureauProductName[\'Equifax\'] !== undefined && responseObj.mapBureauProductName[\'Equifax\'].length \u003E 0 ) {\n                        	helper.renderScreenForProductSelection(component, this, \'Equifax\');       \n                            console.log(\'Calling default bureau Equifax\');\n                        }\n                    }\n                } else {\n                    this.handleErrors(responseObj.sWarningMessage, \"warning\");\n                    component.set(\"v.showSpinner\", false);\n                }\n\n            } else {\n                component.set(\"v.showSpinner\", false);\n                this.handleErrors(response.getError());\n                console.log(\'Error \', response.getError());\n            }\n\n        });\n\n        $A.enqueueAction(action);\n    },\n    \"createCreditReport\":function(component, binItem, isRunReport, isUpdate) {\n        var requestId = component.get(\"v.requestId\");\n        if (requestId == undefined) {\n            requestId = \'\';\n        }\n        var action = component.get(\"c.createCreditReport\");\n        action.setParams({\n            \"parentRecordId\": component.get(\"v.recordId\"),\n            \"selectedProduct\": component.get(\"v.selectedProduct\"),\n            \"jsonString\": JSON.stringify(binItem),\n            \"isRunReport\": isRunReport,\n            \"isUpdate\": isUpdate,\n            \"requestId\": requestId,\n            \"bureauName\": component.get(\"v.selectedBureau\"),\n            \"isGlobalSearch\": component.get(\"v.isGlobalSearchOnExperian\"),\n            \"bureauSubCode\": component.get(\"v.bureauSubCode\")\n        });\n\n        component.set(\"v.showSpinner\", true);\n\n        action.setCallback(this, function(response) {\n            var state = response.getState();\n            if (state === \"SUCCESS\") {\n                \n                this.closePage();\n                \n                if (isRunReport && isUpdate) {\n                    this.showMessageWithSuccess($A.get(\"$Label.cloudmaven_bcr.Run_Report_With_Save_Success\"));\n                } else if (!isRunReport && isUpdate) {\n                    this.showMessageWithSuccess($A.get(\"$Label.cloudmaven_bcr.Save_Success\"));\n                } else if (isRunReport && !isUpdate) {\n                    this.showMessageWithSuccess($A.get(\"$Label.cloudmaven_bcr.Run_Report_Success\"));\n                } else {\n                    this.showMessageWithSuccess($A.get(\"$Label.cloudmaven_bcr.Credit_Report_Service_Submitted\"));\n                }\n                $A.get(\'e.force:refreshView\').fire();\n                component.set(\"v.showSpinner\", false);\n                \n            } else {\n                component.set(\"v.showSpinner\", false);\n                this.handleErrors(response.getError());\n                console.log(\'Error \', response.getError());\n            }\n            component.set(\"v.showSpinner\", false);\n        });\n        $A.enqueueAction(action);\n    },\n    \"closePage\":function(component, event, helper) {\n        if (typeof sforce !== \'undefined\' && sforce.one) {\n            console.log(\'Close the Modal\');\n            sforce.one.back(); \n        } else {\n            console.log(\'Refrsh the Page\');\n            \n            window.location.href = window.location.href; \n        }\n    },\n    \"showMessageWithSuccess\":function(msg) {\n        let toastParams = {\n            title: \"Success\",\n            mode: \"dismissible\",\n            message: \"Operation Successful\", \n            type: \"success\"\n        };\n        if (msg) {\n            toastParams.message = msg;\n        }\n        let toastEvent = $A.get(\"e.force:showToast\");\n        toastEvent.setParams(toastParams);\n        toastEvent.fire();\n    },\n    \"handleErrors\":function(errors, type) {\n        \n        let toastParams = {\n            title: \"Error\",\n            mode: \"sticky\",\n            message: \"Unknown error\", \n            type: type ? type : \"error\"\n        };\n        \n        if (errors && Array.isArray(errors) && errors.length \u003E 0) {\n            toastParams.message = errors[0].message;\n        } else if (typeof errors == \"string\") {\n            toastParams.message = errors;\n        }\n        \n        let toastEvent = $A.get(\"e.force:showToast\");\n        toastEvent.setParams(toastParams);\n        toastEvent.fire();\n    },\n    \"processSearchResults\":function(component, res) {\n        \n        component.set(\"v.requestId\", res.requestId);\n        \n        var selectedBureau = component.get(\"v.selectedBureau\");\n        \n        if( selectedBureau == \"Experian\" ) {\n            if( res.data !== undefined ) {\n            	res.results = res.data;\n            }\n            if (res.results != undefined && Array.isArray(res.results) && res.results.length \u003E 0 ) {\n                \n                var scoreThreshold = 90;\n                if (component.get(\"v.minScore\") != undefined) {\n                    \n                    scoreThreshold = parseFloat(component.get(\"v.minScore\"));\n                }\n                \n                var indx = 0;\n                var isGlobalSearchOnExperian = false;\n                for (let binItem of res.results) {\n                    \n                    if( binItem.bin != undefined ) {\n                        isGlobalSearchOnExperian = false;\n                    }\n                    else if( binItem.gbin != undefined ) {\n                    	isGlobalSearchOnExperian = true;    \n                    }\n                    if ( ( isGlobalSearchOnExperian ? binItem.matchReliabilityCode : binItem.reliabilityCode \u003E= scoreThreshold ) || res.results.length == 1) {\n                        break;\n                    }\n                    indx++;\n                }\n                var selectedRow = res.results[indx];\n                component.set(\"v.selectedRow\", selectedRow);\n                component.set(\"v.data\", res.results);\n                component.set(\"v.isDataAvailable\", true);\n                component.set(\"v.message\", \"\");\n                component.set(\"v.selectedIndex\", indx);\n                component.set(\"v.isGlobalSearchOnExperian\", isGlobalSearchOnExperian);\n                \n            } else {\n                if( res.auth !== undefined && !res.auth ){\n                	component.set(\"v.message\", $A.get(\"$Label.cloudmaven_bcr.Authorisation_Error_Message\") );     \n                }\n                else if( res.fault ){\n                    component.set(\"v.message\", res.fault.faultstring ); 	   \n                }\n                else {\n                    if( res.results !== undefined ) {\n                        if(Array.isArray(res.results) && res.results.length == 0 ) {\n                        	component.set(\"v.message\", $A.get(\"$Label.cloudmaven_bcr.No_Matching_Record_Found_For_Search\"));       \n                        }\n                        else {\n                        	component.set(\"v.message\", res.results);       \n                        }\n                    }\n                    else if (res.responseMessage || res.sMessage) {\n                        \n                        var resMsgObj = JSON.parse(res.sMessage);\n                        if( resMsgObj != undefined && resMsgObj.errors != undefined && resMsgObj.errors.length \u003E 0 ) {\n                        	var lstErrors = [];\n                            for (let err of resMsgObj.errors ) {\n                                lstErrors.push(err.message);\n                            }\n                            \n                            component.set(\"v.message\", \'Error : \u003Cbr/\u003E\' + lstErrors.join(\"\u003Cbr/\u003E\"));    \n                        }\n                        else {\n                        	component.set(\"v.message\", res.responseMessage ? res.responseMessage : res.sMessage);\n                        }\n                    } else {\n                        \n                        var lstErrors = [];\n                        for (let err of res.errors) {\n                            lstErrors.push(err.message ? err.message : err.errorMsg);\n                        }\n                        \n                        component.set(\"v.message\", \'Error : \u003Cbr/\u003E\' + lstErrors.join(\"\u003Cbr/\u003E\"));\n                    }\n                }\n                component.set(\"v.isDataAvailable\", false);\n            } \n        }\n        \n        \n        if( selectedBureau == \"Paynet\" ) {\n            if (res.listCompanyResults != undefined && res.listCompanyResults.length \u003E 0) {\n            	var scoreThreshold = 90;\n                if (component.get(\"v.minScore\") != undefined) {\n                    \n                    scoreThreshold = parseFloat(component.get(\"v.minScore\"));\n                }\n                \n                var indx = 0;\n                var selectedRow = res.listCompanyResults[indx];\n                for ( let searchItem of res.listCompanyResults ) {\n                    if (searchItem.match_score  \u003E= scoreThreshold || res.listCompanyResults.length == 1) {\n                        break;\n                    }\n                    indx++;\n                }\n                \n                if( indx \u003C res.listCompanyResults.length ) {\n                	selectedRow = res.listCompanyResults[indx];    \n                }\n                component.set(\"v.selectedRow\", selectedRow);\n                component.set(\"v.data\", res.listCompanyResults);\n                component.set(\"v.isDataAvailable\", true);\n                component.set(\"v.message\", \"\");\n                \n            } else {\n                if( ( res.listCompanyResults == undefined || res.listCompanyResults.length == 0 ) && res.displayError == null && res.responseDescription == null ) {\n                	res.displayError = $A.get(\"$Label.cloudmaven_bcr.No_Search_Result_On_Paynet\");    \n                }\n                if (res.displayError || res.responseDescription ) {\n                    \n                    component.set(\"v.isDataAvailable\", false);\n                    component.set(\"v.message\", res.displayError ? res.displayError : res.responseDescription );\n                } else {\n                    \n                    var lstErrors = [];\n                    for (let err of res.displayError ) {\n                        lstErrors.push(err.message);\n                    }\n                    \n                    component.set(\"v.isDataAvailable\", false);\n                    component.set(\"v.message\", \'Error : \u003Cbr/\u003E\' + lstErrors.join(\"\u003Cbr/\u003E\"));\n                }\n            }\n        }\n    },\n    \"renderScreenForProductSelection\":function(component, helper, bureauName) {\n    	var lstProductEntitlements = [];\n        if( bureauName == \'Experian\' ) {\n            lstProductEntitlements = component.get(\'v.experianProducts\');\n            let lstProducts = [];\n            for( var prod of lstProductEntitlements ){\n                if( prod.indexOf(\'Search\') == -1 ) {\n                    lstProducts.push(prod);    \n                }    \n            }\n            component.set(\"v.lstProducts\", lstProducts);\n            if( lstProducts.length == 1 ) {\n                component.set(\"v.selectedProduct\", lstProducts[0]);\n            }\n            helper.lookForBINOnRecord(component, \'Experian\');     \n        }\n        else if( bureauName == \'Paynet\' ) {\n            lstProductEntitlements = component.get(\'v.paynetProducts\');\n            let lstProducts = [];\n            for( var prod of lstProductEntitlements ){\n                if( prod.indexOf(\'Search\') == -1 ) {\n                    lstProducts.push(prod);    \n                }    \n            }\n            component.set(\"v.lstProducts\", lstProducts);\n            if( lstProducts.length == 1 ) {\n                component.set(\"v.selectedProduct\", lstProducts[0]);\n            }\n            helper.lookForBINOnRecord(component, \'Paynet\');     \n        }  \n        component.set(\"v.selectedBureau\", bureauName);\n        console.log(\'moved to next step\');\n        component.set(\"v.currentStep\", 2);\n	},\n    \"checkForExistingReports\":function(component, helper) {\n    	console.log(\'checkForExistingReports \u003E\u003E\u003E\u003E\' + component.get(\"v.recordId\"));\n        var action = component.get(\"c.isExistingReportAvailable\");\n        action.setParams({\n            \"recordId\": component.get(\"v.recordId\")\n        });\n        \n        action.setCallback(this, function(response) {\n            var state = response.getState();\n            if (state === \"SUCCESS\") {\n                let res = response.getReturnValue();\n                if( res != undefined ) {\n                    component.set(\"v.lastReportRunDate\", res);\n                    component.set(\"v.runReportConfirmMsg\", $A.get(\"$Label.cloudmaven_bcr.Report_Run_Confirmation_Box_Message\").replace(\'{{DATE}}\', res));\n                }\n\n            } else {\n                component.set(\"v.message\", response.getError());\n                console.log(\'Error \', response.getError());\n                this.handleErrors(response.getError());\n            }\n            component.set(\"v.showSpinner\", false);\n        });\n        $A.enqueueAction(action);    \n    }\n  }\n};\n", def, "evaluateInSandbox");
});
