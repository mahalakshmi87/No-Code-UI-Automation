 and set context for the meeting<\/li>\n                <li>Define the business problem and offer a solution<\/li>\n                <li>Articulate the value and benefit of a product or solution<\/li>\n                <li>Delivers complex information in a short and clear manner<\/li>\n                <li>Make compelling points<\/li>\n                <li>Use storytelling to connect with the audience<\/li>\n            <\/ul>\n        ","InstructionTitle":"Get Started","SubmitButton":"Request Feedback from Einstein","IntroDescription":"Get AI-generated feedback on a recorded sales pitch for a product or solution.","IntroTitle":"Receive Feedback on a Sales Pitch"},"SidePanelContentType":{"GuidanceSet":"Guidance Set","TrailheadModule":"Trailhead","HelpDoc":"Help","EnablementProgram":"Program","Link":"Link"},"LexAF":{"stepNotComplete":"Not Complete","other":"Dive Deeper","restore":"Restore","archive":"Archive","completedStepsCongrats":"Congrats! You completed all the items.","percentComplete":"{0}% complete","percent":"{0}%","recommended":"Get Going","archived":"Archived","showArchivedScenarios":"Archived Guidance Sets","expand":"Expand","progress":"Progress","completedOnDate":"Completed on {0}","stepCount":"{0} steps","stepComplete":"Complete","collapse":"Collapse"},"Buttons":{"cancel":"Cancel","undo":"Undo","submit":"Submit","back":"Back","skip":"Skip"},"Wizard":{"next":"Next"},"Sidebar":{"Resize":"Resize","BackButton":"Back","CloseButton":"Close"},"GuidanceHubCelebration":{"Subtitle":"You completed {0}.","Description":"Keep exploring to get the most out of Salesforce.","Title":"Nice work!","Icon":"standard:guidance_center","ButtonText":"View More Guidance Sets"}}}],false,false);